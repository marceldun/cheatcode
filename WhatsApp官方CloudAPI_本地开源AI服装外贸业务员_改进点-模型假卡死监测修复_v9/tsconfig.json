{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true
  },
  "include": ["cloud/**/*.ts", "local/**/*.mjs", "test/**/*.ts"]
}

